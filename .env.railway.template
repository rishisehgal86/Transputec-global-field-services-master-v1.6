# Railway Environment Variables Template
# Copy these to Railway Dashboard → Variables tab

# ============================================
# DATABASE (Auto-configured by Railway)
# ============================================
DATABASE_URL=${{MySQL.DATABASE_URL}}
# Railway automatically references the MySQL service


# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_RANDOM_32_CHAR_STRING


# ============================================
# MANUS OAUTH (if using Manus authentication)
# ============================================
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://login.manus.im
VITE_APP_ID=REPLACE_WITH_YOUR_MANUS_APP_ID
OWNER_OPEN_ID=REPLACE_WITH_YOUR_OWNER_OPENID
OWNER_NAME=Your Name


# ============================================
# APPLICATION SETTINGS
# ============================================
VITE_APP_TITLE=Transputec Dispatch
VITE_APP_LOGO=https://your-domain.com/logo.png
NODE_ENV=production
PORT=3000


# ============================================
# STRIPE PAYMENT PROCESSING (if using)
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_PUBLISHABLE_KEY
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_PUBLISHABLE_KEY

# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Get from: https://dashboard.stripe.com/products
STRIPE_STARTER_PRICE_ID=price_REPLACE_WITH_STARTER_PRICE_ID
STRIPE_ENTERPRISE_PRICE_ID=price_REPLACE_WITH_ENTERPRISE_PRICE_ID


# ============================================
# GOOGLE PLACES API (for address geocoding)
# ============================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=REPLACE_WITH_YOUR_GOOGLE_API_KEY


# ============================================
# EMAIL / SMTP (if using email notifications)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=noreply@yourdomain.com


# ============================================
# ADMIN CONTACT
# ============================================
ADMIN_EMAIL=admin@yourdomain.com


# ============================================
# OPTIONAL: ANALYTICS (if using)
# ============================================
# VITE_ANALYTICS_ENDPOINT=https://analytics.yourdomain.com
# VITE_ANALYTICS_WEBSITE_ID=your-website-id


# ============================================
# OPTIONAL: CUSTOM API ENDPOINTS
# ============================================
# BUILT_IN_FORGE_API_URL=https://api.manus.im
# BUILT_IN_FORGE_API_KEY=your-api-key
# VITE_FRONTEND_FORGE_API_KEY=your-frontend-key
# VITE_FRONTEND_FORGE_API_URL=https://api.manus.im


# ============================================
# NOTES
# ============================================
# 1. Never commit this file with real values
# 2. Add to Railway via Dashboard → Variables tab
# 3. Variables prefixed with VITE_ are exposed to frontend
# 4. Railway auto-injects DATABASE_URL from MySQL service
# 5. Use different values for development vs production

